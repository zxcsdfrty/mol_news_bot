# 複製為 .env 後填入（.env 已列入 .gitignore，切勿提交）
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 群組 chat_id 為負數，例如 -1001234567890
TELEGRAM_CHAT_ID=-1001234567890

SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key：僅供排程程式寫入使用，不可放在網頁
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# 選填（WEB_URL 留空時部署腳本會自動填入 GitHub Pages 網址）
MAX_ITEMS_PER_PUSH=30
MAX_AGE_HOURS=36
# 夜間靜音（台灣時間），空白代表 24 小時推播；例 23-7
QUIET_HOURS=
WEB_URL=
MIN_PUSH_INTERVAL_MIN=25

# ---- 以下僅供部署腳本使用（deploy/push_secrets.*），程式執行不需要 ----
# 網頁用的 anon key（可公開，搭配 RLS 唯讀）
SUPABASE_ANON_KEY=eyJhbGciOi...
# 選填：填了部署時可用 psql 自動建表（Supabase → Project Settings → Database → Connection string → URI）
SUPABASE_DB_URL=
# 選填：網頁限登入者使用時設為 true（需搭配 schema.sql 方案 B）
REQUIRE_LOGIN=
